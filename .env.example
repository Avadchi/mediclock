# OPTIONAL. Leave empty to run in LocalStorage demo mode (default).
# Only VITE_ values are bundled into the client. Firebase web config is not a secret,
# but access must be protected with Firestore security rules (see firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
