rules_version = '2';
// TEMPLATE for production deployment. Requires custom claims: role ('pharmacist'|'medical_officer'|'admin') and clinicId.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function clinic() { return request.auth.token.clinicId; }

    match /clinics/{id}  { allow read: if signedIn(); allow write: if role() == 'admin'; }
    match /users/{id}    { allow read: if signedIn(); allow write: if role() == 'admin'; }

    match /batches/{id} {
      allow read: if signedIn();
      allow create, update: if role() == 'pharmacist' && request.resource.data.clinicId == clinic()
                            && request.resource.data.qty >= 0;
      allow delete: if false;
    }
    match /transfers/{id} {
      allow read: if signedIn();
      allow create: if role() == 'pharmacist'
                    && (request.resource.data.fromClinic == clinic() || request.resource.data.toClinic == clinic());
      // Status changes must be enforced server-side (Cloud Function) in production; stock moves only on 'Completed'.
      allow update: if signedIn() && role() in ['pharmacist', 'medical_officer', 'admin'];
      allow delete: if false;
    }
    match /audit/{id} { allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if false; }
  }
}
